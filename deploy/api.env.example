# Documentation only: operator installs a private /etc/eds/api.env (0600).
HOST=127.0.0.1
PORT=3000
SCENARIO_DATA_FILE=/var/lib/eds/scenarios.json
SCENARIO_CONTENT_DIR=/srv/eds/current/content/scenarios
# Empty disables each privileged role. Demo Studio needs neither key.
AUTHOR_KEY=
REVIEWER_KEY=
CLASSROOM_TTL_MINUTES=30
CLASSROOM_MIN_PARTICIPANTS=3
CLASSROOM_MAX_PARTICIPANTS=100
CLASSROOM_MAX_ROOMS=100
# Set only if a trusted proxy rewrites Host; exact actual HTTPS Origin, no wildcard.
# CLASSROOM_ALLOWED_ORIGIN=https://simulator.example.invalid
