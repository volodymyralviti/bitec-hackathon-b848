# This file is documentation. Export variables in your shell; .env is not auto-loaded.
PORT=3000
# Set independent random values (>=32 characters) server-side. Empty disables role.
AUTHOR_KEY=
REVIEWER_KEY=
# Optional absolute paths; defaults are apps/server/.data/scenarios.json and content/scenarios.
# SCENARIO_DATA_FILE=
# SCENARIO_CONTENT_DIR=
# PostgreSQL is not configured in this checkout. DATABASE_URL fails closed until an adapter is implemented.

# Ephemeral classroom bounds; no database or participant identity.
CLASSROOM_TTL_MINUTES=30
CLASSROOM_MIN_PARTICIPANTS=3
CLASSROOM_MAX_PARTICIPANTS=100
CLASSROOM_MAX_ROOMS=100
# Optional exact browser Origin if the trusted reverse proxy changes Host.
# CLASSROOM_ALLOWED_ORIGIN=https://your-frontend.example
